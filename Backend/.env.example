NODE_ENV=development
PORT=8791
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
OPENAI_API_KEY=replace-with-project-api-key
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
API_PUBLIC_URL=http://127.0.0.1:8791
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=120
# Optional accounting rates; update from current OpenAI pricing without a deploy.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
OPENAI_IMAGE_COST_PER_CALL=0
